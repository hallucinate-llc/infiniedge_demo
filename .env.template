# InfinieEdge Demo Environment Configuration
# Copy this file to .env and modify as needed

# ===========================================
# Infrastructure Configuration
# ===========================================

# Redis Configuration
REDIS_HOST=shared-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# PostgreSQL Configuration  
POSTGRES_HOST=shared-postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=infiniedge

# ===========================================
# Service-Specific Configuration
# ===========================================

# AegisEdgeAI
AEGIS_TPM_HOST=127.0.0.1
AEGIS_TPM_PORT=2321
AEGIS_FLASK_ENV=production

# SPEAR Platform
SPEAR_CONFIG_PATH=/app/config.yml
SPEAR_LOG_LEVEL=INFO

# YoMo Framework
YOMO_ENV=production
YOMO_LOG_LEVEL=INFO

# Shifu Gateway
SHIFU_ENV=production

# Edge Whisper
NODE_ENV=production
WHISPER_MODEL_PATH=/app/models

# EDA Platform
EDA_LOG_LEVEL=INFO
EDA_DATA_PATH=/app/data

# AIOps Platform
AIOPS_LOG_LEVEL=INFO
AIOPS_MODEL_PATH=/app/models

# Transformers Service
HF_HOME=/app/cache
TORCH_HOME=/app/torch_cache
TRANSFORMERS_CACHE=/app/cache

# Megatron-LM
NCCL_DEBUG=INFO
MEGATRON_DATA_PATH=/app/data

# Whisper Fine-tune
WHISPER_FT_MODEL_PATH=/app/models

# ===========================================
# Network Configuration
# ===========================================

# Docker Network
NETWORK_NAME=infiniedge-network
NETWORK_SUBNET=172.20.0.0/16

# ===========================================
# Resource Limits (for production deployment)
# ===========================================

# Memory limits (in MB)
AEGIS_MEMORY_LIMIT=1024
SPEAR_MEMORY_LIMIT=2048
YOMO_MEMORY_LIMIT=512
SHIFU_MEMORY_LIMIT=512
WHISPER_MEMORY_LIMIT=1024
EDA_MEMORY_LIMIT=1024
AIOPS_MEMORY_LIMIT=2048
TRANSFORMERS_MEMORY_LIMIT=4096
MEGATRON_MEMORY_LIMIT=8192
WHISPER_FT_MEMORY_LIMIT=2048

# CPU limits (in cores)
AEGIS_CPU_LIMIT=1.0
SPEAR_CPU_LIMIT=2.0
YOMO_CPU_LIMIT=0.5
SHIFU_CPU_LIMIT=0.5
WHISPER_CPU_LIMIT=1.0
EDA_CPU_LIMIT=1.0
AIOPS_CPU_LIMIT=2.0
TRANSFORMERS_CPU_LIMIT=4.0
MEGATRON_CPU_LIMIT=8.0
WHISPER_FT_CPU_LIMIT=2.0