# Security Configuration for InfinieEdge Demo Platform

# ===============================================
# SECRETS MANAGEMENT (Use with Docker Secrets)
# ===============================================

# Database credentials
POSTGRES_ROOT_PASSWORD_FILE=/run/secrets/postgres_root_password
POSTGRES_USER_PASSWORD_FILE=/run/secrets/postgres_user_password
REDIS_PASSWORD_FILE=/run/secrets/redis_password

# API Keys and tokens
AEGIS_API_KEY_FILE=/run/secrets/aegis_api_key
SPEAR_TOKEN_FILE=/run/secrets/spear_token
YOMO_SECRET_FILE=/run/secrets/yomo_secret

# Certificates
SSL_CERT_FILE=/run/secrets/ssl_cert
SSL_KEY_FILE=/run/secrets/ssl_key
CA_CERT_FILE=/run/secrets/ca_cert

# ===============================================
# SECURITY SETTINGS
# ===============================================

# Container security
DOCKER_USER_ID=1001
DOCKER_GROUP_ID=1001
SECURITY_OPT=no-new-privileges:true

# Network security
ENABLE_TLS=true
TLS_MIN_VERSION=1.2
NETWORK_ENCRYPTION=true

# Resource limits (hardened)
MAX_MEMORY_PER_SERVICE=2G
MAX_CPU_PER_SERVICE=2.0
MAX_OPEN_FILES=65536

# Logging and monitoring
LOG_LEVEL=INFO
AUDIT_LOGGING=true
METRICS_ENABLED=true
SECURITY_SCANNING=true

# ===============================================
# HARDENED RUNTIME SETTINGS
# ===============================================

# Disable unnecessary capabilities
DROP_ALL_CAPABILITIES=true
REQUIRED_CAPABILITIES=CHOWN,SETUID,SETGID,NET_BIND_SERVICE

# Read-only root filesystem
READONLY_ROOT_FS=true
TMPFS_SIZE=100m

# Process limits
MAX_PROCESSES=100
NICE_LEVEL=0

# File system security
UMASK=027
NO_EXEC_TMP=true